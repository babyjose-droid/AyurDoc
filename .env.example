# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://ayurcare:password@localhost:5432/ayurcare_dev"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3000

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRY_WEB=8h
JWT_EXPIRY_MOBILE=30d

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── OTP (MSG91) ─────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-otp-template-id
MSG91_SENDER_ID=AYRCAR
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_RESENDS=3
OTP_LOCKOUT_MINUTES=15

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_PATIENT_DOCS=ayurcare-patient-docs-prod
S3_BUCKET_CLINIC_ASSETS=ayurcare-clinic-assets-prod
S3_BUCKET_GENERATED_PDFS=ayurcare-generated-pdfs-prod

# ─── Email (AWS SES) ─────────────────────────────────────────────────────────
SES_FROM_EMAIL=noreply@ayurcare.in
SES_FROM_NAME=AyurCare Platform

# ─── Super Admin ─────────────────────────────────────────────────────────────
SUPER_ADMIN_SECRET=bootstrap-secret-for-first-admin-creation

# ─── Clinic ID Prefix ────────────────────────────────────────────────────────
CLINIC_ID_PREFIX=AYR
